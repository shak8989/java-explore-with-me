      "name": "01 - Create comment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Comment created - status 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Comment ID returned\", function () {\r\n    const json = pm.response.json();\r\n\r\n    pm.expect(json.id).to.be.a(\"number\");\r\n    pm.expect(json.text).to.eql(\"Postman feature test comment\");\r\n\r\n    pm.collectionVariables.set(\"commentId\", json.id);\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"text\": \"Postman feature test comment\"\r\n}",
