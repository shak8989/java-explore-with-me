    {
      "name": "02 - Get comments",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Get comments - status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Created comment is in the list\", function () {\r\n    const comments = pm.response.json();\r\n    const commentId = Number(pm.collectionVariables.get(\"commentId\"));\r\n\r\n    pm.expect(comments).to.be.an(\"array\");\r\n\r\n    const found = comments.some(comment =>\r\n        comment.id === commentId\r\n    );\r\n\r\n    pm.expect(found).to.be.true;\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/events/5/comments",
