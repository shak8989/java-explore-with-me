    {
      "name": "03 - Update comment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Update comment - status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Comment text updated correctly\", function () {\r\n    const json = pm.response.json();\r\n    const commentId = Number(pm.collectionVariables.get(\"commentId\"));\r\n\r\n    pm.expect(json.id).to.eql(commentId);\r\n    pm.expect(json.text).to.eql(\"Updated by Postman test\");\r\n    pm.expect(json.authorId).to.eql(1);\r\n    pm.expect(json.eventId).to.eql(5);\r\n});\r\n"
            ]
          }
        }
      ],
